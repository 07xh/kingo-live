    "spin_ms": 20.0,
    "cpu_affinity": -1,
    "early_data_for_write": false,
    "prebuild": false
  },
  "crosscheck": {
    "channels": {"official_list": 1.0, "wap_schedule": 0.8, "credit_summary": 0.6, "zxxq": 0.5},

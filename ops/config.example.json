      "host": "TARGET_HOST",
      "poll_interval_base_ms": 60000.0,
      "poll_interval_hot_ms": 2000.0,
      "hot_rounds": 10,
      "sessions": 1,
      "respect_retry_after": true,
      "catalog_path": "/hsjw//wap/mycourseschedule.action"
